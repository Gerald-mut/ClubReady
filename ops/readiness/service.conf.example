# Install outside the repository at /etc/clubready/readiness-service.conf.
[clubready-readiness]
host=REPLACE_WITH_DATABASE_HOST
port=5432
dbname=postgres
user=clubready_scheduler
sslmode=verify-full
# sslrootcert=/etc/clubready/database-ca.pem
# Password belongs in the mode-0600 readiness.pgpass file, never here.
